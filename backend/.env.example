# Select Firebase verification instead of old local JWT login:
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# Set absolute path to your downloaded Firebase service-account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=901ec.json
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# v10: third-party AI keys are SERVER-SIDE ONLY; do not put these in frontend VITE_ vars.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
